# Copy to .env — never commit the copy.

# sandbox | production
TRADE_DESK_ENV=sandbox

# tradier | (later: other adapters)
TRADE_DESK_BROKER=tradier

# spx-iron-fly | (later: other strategies)
TRADE_DESK_STRATEGY=spx-iron-fly

# manual = view only, confirm = intents wait for a click, auto = engine may send
TRADE_DESK_MODE=confirm

TRADIER_BASE_URL=https://sandbox.tradier.com/v1
TRADIER_ACCESS_TOKEN=
TRADIER_ACCOUNT_ID=
